#!/usr/bin/env python3
"""Derive DORA + Flow metrics from the engineer cost-ledger and an optional
delivery ledger.

Grounding: performance bands are the 2024 DORA State of DevOps clusters, not
invented thresholds. Flow efficiency uses the standard formula
(active time / total flow time) and is reported ONLY when active time is
actually captured per step — it is never approximated with a time-gap
heuristic. Failure-dependent keys (change failure rate, MTTR, reliability)
print only when a delivery ledger supplies a real failure signal.

Usage: dora-report [--since 30d] [--repo owner/name] [--ledger PATH]
                   [--delivery-ledger PATH]
"""
import argparse
import json
import os
import sys
from collections import defaultdict
from datetime import datetime, timedelta, timezone

# 2024 DORA State of DevOps performance clusters (elite/high/medium/low).
# Source: 2024 DORA report; see SKILL.md for citations.
DONE_PHASES = {"done", "deliver"}


def parse_ts(s):
    if not s:
        return None
    s = s.replace("Z", "+00:00")
    try:
        dt = datetime.fromisoformat(s)
    except ValueError:
        return None
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)


def parse_since(s):
    if not s:
        return None
    unit = s[-1]
    n = int(s[:-1])
    mult = {"d": 1, "w": 7, "h": 1 / 24}.get(unit)
    if mult is None:
        sys.exit(f"bad --since: {s} (use e.g. 30d, 4w, 12h)")
    return datetime.now(timezone.utc) - timedelta(days=n * mult)


def default_ledger():
    home = os.environ.get("CODEX_HOME") or os.path.expanduser("~/.claude")
    return os.path.join(home, "private-ai-harness", "engineer-cost-ledger.jsonl")


def default_delivery_ledger():
    home = os.environ.get("CODEX_HOME") or os.path.expanduser("~/.claude")
    return os.path.join(home, "private-ai-harness", "delivery-ledger.jsonl")


def read_jsonl(path):
    if not path or not os.path.exists(path):
        return []
    rows = []
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(json.loads(line))
            except json.JSONDecodeError:
                continue
    return rows


def percentile(values, p):
    if not values:
        return None
    values = sorted(values)
    k = (len(values) - 1) * p
    lo = int(k)
    hi = min(lo + 1, len(values) - 1)
    return values[lo] + (values[hi] - values[lo]) * (k - lo)


def fmt_hours(h):
    if h is None:
        return "n/a"
    if h < 1:
        return f"{h * 60:.0f}m"
    if h < 48:
        return f"{h:.1f}h"
    return f"{h / 24:.1f}d"


def band_lead_time(hours):
    # DORA 2024: elite <1d, high 1d-1wk, medium 1wk-1mo, low 1mo-6mo.
    if hours is None:
        return ""
    if hours < 24:
        return "elite (<1 day)"
    if hours < 24 * 7:
        return "high (1 day-1 week)"
    if hours < 24 * 30:
        return "medium (1 week-1 month)"
    return "low (1-6 months)"


def band_recovery(hours):
    # DORA 2024: elite <1h, high/medium <1d, low 1wk-1mo.
    if hours is None:
        return ""
    if hours < 1:
        return "elite (<1 hour)"
    if hours < 24:
        return "high/medium (<1 day)"
    return "low (1 week-1 month)"


def band_cfr(pct):
    # DORA 2024: elite <5%, high/medium 0-15%, low 46-60%.
    if pct is None:
        return ""
    if pct < 5:
        return "elite (<5%)"
    if pct <= 15:
        return "high-medium (0-15%)"
    return "below standard (DORA low band 46-60%)"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--since")
    ap.add_argument("--repo")
    ap.add_argument("--ledger", default=default_ledger())
    ap.add_argument("--delivery-ledger", default=default_delivery_ledger())
    args = ap.parse_args()

    since = parse_since(args.since)
    rows = read_jsonl(args.ledger)
    if args.repo:
        rows = [r for r in rows if r.get("repo") == args.repo]

    # Group cost-ledger rows into sessions. Each row is a phase checkpoint with
    # a timestamp; some rows may carry active_seconds (the step's start->end
    # working duration) if cost-checkpoint recorded it.
    sessions = defaultdict(lambda: {"ts": [], "active": 0.0, "has_active": False,
                                    "done": False})
    for r in rows:
        sid = r.get("session_id")
        ts = parse_ts(r.get("timestamp"))
        if not sid or not ts:
            continue
        if since and ts < since:
            continue
        s = sessions[sid]
        s["ts"].append(ts)
        if r.get("phase") in DONE_PHASES:
            s["done"] = True
        act = r.get("active_seconds")
        if isinstance(act, (int, float)):
            s["active"] += act / 3600.0
            s["has_active"] = True

    cycle_hours, flow_eff = [], []
    for sid, s in sessions.items():
        tss = sorted(s["ts"])
        span = (tss[-1] - tss[0]).total_seconds() / 3600.0
        cycle_hours.append(span)
        if s["has_active"] and span > 0:
            flow_eff.append(min(s["active"] / span, 1.0))

    total_sessions = len(sessions)
    delivered = sum(1 for s in sessions.values() if s["done"])

    print("=== Delivery Metrics (DORA 2024 bands + Flow) ===")
    if args.repo:
        print(f"repo: {args.repo}")
    if args.since:
        print(f"window: last {args.since}")
    print(f"ledger: {args.ledger}")
    print()
    print("Timestamp-derived (always available):")
    print(f"  Deployment frequency : {delivered} delivered "
          f"(of {total_sessions} work-item session(s)) in window")
    cp50 = percentile(cycle_hours, 0.5)
    cp90 = percentile(cycle_hours, 0.9)
    print(f"  Cycle time (harness) : p50 {fmt_hours(cp50)}  p90 {fmt_hours(cp90)}"
          "   (first->last phase; not DORA commit->deploy lead time)")
    if flow_eff:
        eff = sum(flow_eff) / len(flow_eff) * 100
        print(f"  Flow efficiency      : {eff:.0f}%  "
              "(active/total; DORA-adjacent: most teams 15-40%, top 40-50%)")
    else:
        print("  Flow efficiency      : needs active-time capture "
              "(record active_seconds per step in the cost-ledger)")
    print()

    # DORA lead time is commit->deploy: only the delivery ledger has it.
    dl = read_jsonl(args.delivery_ledger)
    if args.repo:
        dl = [d for d in dl if d.get("repo") == args.repo]
    if since:
        dl = [d for d in dl
              if (parse_ts(d.get("merged_at")) or datetime.now(timezone.utc)) >= since]

    print("DORA — from delivery ledger (real change/failure signal):")
    if not dl:
        print("  Lead time for change : needs delivery ledger "
              "(created_at/deployed_at)")
        print("  Change failure rate  : needs incident linkage")
        print("  MTTR (recovery)      : needs incident linkage")
        print("  Reliability (SLO)    : needs incident linkage")
    else:
        leads = []
        for d in dl:
            c = parse_ts(d.get("created_at"))
            dep = parse_ts(d.get("deployed_at")) or parse_ts(d.get("merged_at"))
            if c and dep:
                leads.append((dep - c).total_seconds() / 3600.0)
        lp50 = percentile(leads, 0.5)
        print(f"  Lead time for change : p50 {fmt_hours(lp50)}  [{band_lead_time(lp50)}]")
        total = len(dl)
        failed = sum(1 for d in dl if d.get("caused_incident"))
        cfr = failed / total * 100 if total else None
        print(f"  Change failure rate  : "
              + (f"{cfr:.0f}%  ({failed}/{total})  [{band_cfr(cfr)}]"
                 if cfr is not None else "n/a"))
        mttrs = []
        for d in dl:
            st, rt = parse_ts(d.get("incident_start")), parse_ts(d.get("restored_at"))
            if st and rt:
                mttrs.append((rt - st).total_seconds() / 3600.0)
        mttr = percentile(mttrs, 0.5)
        print(f"  MTTR (recovery, p50) : {fmt_hours(mttr)}"
              + (f"  [{band_recovery(mttr)}]" if mttr is not None else ""))
        slo_met = sum(1 for d in dl if d.get("slo_met"))
        print(f"  Reliability          : {slo_met}/{total} deliveries met SLO")
    print()
    print("Flow efficiency is active/total flow time; a low value means wait "
          "time between phases dominates — target the slowest inter-phase gap.")


if __name__ == "__main__":
    main()
